{
  "openapi": "3.1.0",
  "info": {
    "title": "Listnr Studio API",
    "version": "1.0.0",
    "description": "Public read API for Listnr Studio. Catalog, pricing, and docs are anonymous. Video generation is not performed on this host; send people to /create?tool=<toolId>. Anonymous reads are capped at 60 requests per IP per minute on /api/v1, /mcp, and /ask (20 writes). Exceeding the cap returns 429 with RateLimit and Retry-After.",
    "contact": {
      "name": "Listnr Studio",
      "email": "support@listnr.ai",
      "url": "https://studio.listnr.ai/contact"
    }
  },
  "servers": [
    {
      "url": "https://studio.listnr.ai/api/v1",
      "description": "Public sandbox (read-only)"
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Tools and marketing pages"
    },
    {
      "name": "Billing",
      "description": "Published plan and credit limits"
    },
    {
      "name": "Agent",
      "description": "Discovery and authentication hints"
    }
  ],
  "security": [],
  "paths": {
    "/": {
      "get": {
        "operationId": "getApiRoot",
        "tags": [
          "Agent"
        ],
        "summary": "API service descriptor",
        "description": "Returns collections, docs, and authentication pointers.",
        "responses": {
          "200": {
            "description": "Service descriptor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDescriptor"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this IP. Honor RateLimit and Retry-After.",
            "headers": {
              "RateLimit": {
                "schema": {
                  "type": "string"
                },
                "description": "IETF RateLimit header, e.g. limit=60, remaining=0, reset=12"
              },
              "RateLimit-Policy": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tools": {
      "get": {
        "operationId": "listStudioTools",
        "tags": [
          "Catalog"
        ],
        "summary": "List Studio tools",
        "description": "Anonymous list of public Listnr Studio tools for function calling.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional catalog category id"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive search over tool label and id"
          }
        ],
        "responses": {
          "200": {
            "description": "Tool collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolList"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this IP. Honor RateLimit and Retry-After.",
            "headers": {
              "RateLimit": {
                "schema": {
                  "type": "string"
                },
                "description": "IETF RateLimit header, e.g. limit=60, remaining=0, reset=12"
              },
              "RateLimit-Policy": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
