    "/pricing": {
      "get": {
        "operationId": "getStudioPricing",
        "tags": [
          "Billing"
        ],
        "summary": "Published Studio plans",
        "description": "Hobby, Growth, and Ultra prices and monthly credits.",
        "responses": {
          "200": {
            "description": "Pricing snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pricing"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this IP. Honor RateLimit and Retry-After.",
            "headers": {
              "RateLimit": {
                "schema": {
                  "type": "string"
                },
                "description": "IETF RateLimit header, e.g. limit=60, remaining=0, reset=12"
              },
              "RateLimit-Policy": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pages": {
      "get": {
        "operationId": "listStudioPages",
        "tags": [
          "Catalog"
        ],
        "summary": "List public marketing pages",
        "description": "Routes agents can cite, including markdown twins.",
        "responses": {
          "200": {
            "description": "Page list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageList"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this IP. Honor RateLimit and Retry-After.",
            "headers": {
              "RateLimit": {
                "schema": {
                  "type": "string"
                },
                "description": "IETF RateLimit header, e.g. limit=60, remaining=0, reset=12"
              },
              "RateLimit-Policy": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying"
              }
            },
